<?xml version="1.0"?>
<Container version="2">
  <Name>Vynode</Name>
  <Repository>ghcr.io/minerport/vynodetemplatearr:0.1.0-rc.1</Repository>
  <Registry>https://github.com/minerport/VynodeTemplateArr/pkgs/container/vynodetemplatearr</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/minerport/VynodeTemplateArr/issues</Support>
  <Project>https://github.com/minerport/VynodeTemplateArr</Project>
  <Icon>https://raw.githubusercontent.com/minerport/VynodeTemplateArr/main/unraid/vynode-icon.svg</Icon>
  <Overview>Manage Plex collections, posters, overlays, watchlists, and missing media from one self-hosted interface.</Overview>
  <Category>MediaApp:Other:</Category>
  <WebUI>http://[IP]:[PORT:7171]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/minerport/VynodeTemplateArr/main/unraid/vynode.xml</TemplateURL>
  <ExtraParams>--security-opt=no-new-privileges:true --cap-drop=ALL --cap-add=CHOWN --cap-add=SETGID --cap-add=SETUID</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled>0</DateInstalled>
  <DonateText/>
  <DonateLink/>
  <Requires>A base64-encoded 32-byte master key is required; retain it for backup restoration.</Requires>
  <Config Name="Web UI" Target="7171" Default="7171" Mode="tcp" Description="Vynode web and API port." Type="Port" Display="always" Required="true" Mask="false">7171</Config>
  <Config Name="Appdata" Target="/var/lib/vynode" Default="/mnt/user/appdata/vynode" Mode="rw" Description="Persistent database, secrets, jobs, assets, and logs." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/vynode</Config>
  <Config Name="Media" Target="/media" Default="/mnt/user" Mode="rw" Description="Shares allowed for placeholders and local poster folders. Narrow this path when possible." Type="Path" Display="always" Required="true" Mask="false">/mnt/user</Config>
  <Config Name="Public URL" Target="VYNODE_PUBLIC_URL" Default="http://[IP]:7171" Mode="" Description="Browser-visible URL, including reverse-proxy scheme and hostname when used." Type="Variable" Display="always" Required="true" Mask="false">http://[IP]:7171</Config>
  <Config Name="Master Key" Target="VYNODE_MASTER_KEY" Default="" Mode="" Description="Base64-encoded 32-byte encryption key. Back it up securely; changing it makes stored credentials unreadable." Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="Media Roots" Target="VYNODE_MEDIA_ROOTS" Default="/media" Mode="" Description="Comma-separated container paths Vynode may browse." Type="Variable" Display="advanced" Required="true" Mask="false">/media</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="Unraid nobody user ID." Type="Variable" Display="advanced" Required="true" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Unraid users group ID." Type="Variable" Display="advanced" Required="true" Mask="false">100</Config>
  <Config Name="Trust Proxy" Target="VYNODE_TRUST_PROXY" Default="false" Mode="" Description="Set true only behind a trusted reverse proxy." Type="Variable" Display="advanced" Required="true" Mask="false">false</Config>
</Container>
